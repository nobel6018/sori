{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sori",
  "version": "0.6.0",
  "identifier": "com.nobel6018.sori.mobile",
  "build": {
    "beforeDevCommand": "pnpm -C .. exec vite --config mobile/vite.config.ts",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm -C .. exec vite build --config mobile/vite.config.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sori",
        "width": 400,
        "height": 860
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "iOS": {
      "minimumSystemVersion": "17.0"
    }
  }
}
